{
  "name": "vida-plena",
  "version": "1.0.0",
  "description": "Sistema de Gestión Vida Plena",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "build": "vite build --config frontend/vite.config.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.7",
    "@afipsdk/afip.js": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.vidaplena.app",
    "productName": "Vida Plena",
    "directories": {
      "output": "dist"
    },
    "files": [
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}