{
  "name": "vida-plena",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "npm run rebuild && electron-builder"
  },
  "dependencies": {
    "@afipsdk/afip.js": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.vidaplena.app",
    "productName": "Vida Plena",
    "directories": {
      "output": "dist_app"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "backend/**/*",
      "frontend/dist/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
